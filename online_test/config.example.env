# Environment variables for the portable `online_test` bundle (host project).

# Optional: JSON file for custom Crabber PN bases (default: <bundle>/data/crabber_test_pns.json)
# ONLINE_TEST_PN_BASES_PATH=C:/path/to/crabber_test_pns.json

# Crabber + Oracle: same as SFC_View — see config/README_CONFIG.md in SFC_View repo.
# CRABBER_BASE_URL=
# CRABBER_TOKEN=
# CRABBER_USER_ID=
# CRABBER_SITENAME=
# CRABBER_SV_BASE_URL=
# CRABBER_SV_TOKEN=
# CRABBER_SV_USER_ID=
# CRABBER_SV_SITENAME=

# Oracle / SFIS (sfis_tool) — set via sfis_tool/config or env as in your plant.
